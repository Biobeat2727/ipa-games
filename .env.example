# Supabase — database, auth, and postgres_changes subscriptions
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Ably — realtime broadcast channel shared by player, host, and projector.
# Required: without it the three clients never sync.
VITE_ABLY_KEY=your-ably-key-here
